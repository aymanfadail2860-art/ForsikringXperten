# =============================================================================
# Forsikringxperten — environment variables
#
# Copy to .env.local and fill in. Never commit real values.
#
# Rule: only browser-safe values may use the NEXT_PUBLIC_ prefix. Anything
# prefixed NEXT_PUBLIC_ is compiled into the JavaScript bundle and is readable
# by anyone who visits the site.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonicals, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://forsikringxperten.dk


# --- Supabase ----------------------------------------------------------------
# Project URL and anon key. The anon key is public by design; it is safe here
# because Row Level Security denies it access to every table (supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses RLS. SERVER ONLY.
# Used exclusively by the lead intake route and the funnel event route.
# If this ever appears in a NEXT_PUBLIC_ variable, treat it as compromised
# and rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=


# --- Analytics ---------------------------------------------------------------
# All optional. An empty value means the tool is simply not loaded.
# Nothing here runs before the visitor has given consent for its category.

# Google Tag Manager container (statistik category)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 — only loaded directly when GTM is NOT configured
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity (statistik category)
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel (markedsføring category)
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag partner id (markedsføring category)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=


# --- Booking -----------------------------------------------------------------
# External scheduling link (Calendly or similar), used until a native calendar
# integration exists. Leave empty to route booking through the lead funnel
# instead — see src/services/calendar.
NEXT_PUBLIC_BOOKING_URL=


# --- Testing -----------------------------------------------------------------
# Port used by the Playwright suite (defaults to 3100).
# E2E_PORT=3100
# Only needed where the preinstalled Chromium differs from Playwright's own:
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
